---
import { Server, Cloud, Check } from '@lucide/astro';
---

<section id="open-source" class="w-full py-24 border-t border-stone-800/80 bg-[#0A0908]">
  <div class="max-w-6xl mx-auto px-6">
    <div class="text-center max-w-2xl mx-auto mb-16">
      <div class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-stone-900 border border-stone-800 text-stone-300 text-xs font-semibold uppercase tracking-wider mb-4">
        Deployment Freedom
      </div>
      <h2 class="text-3xl sm:text-4xl font-bold text-white mb-4">
        Open source or managed cloud. You decide.
      </h2>
      <p class="text-stone-400 text-base sm:text-lg leading-relaxed">
        Just like Ghost or WordPress, Bebop gives you two ways to run: deploy the free, open-source AGPLv3 stack on your own infrastructure, or let us manage the servers with Bebop Cloud.
      </p>
    </div>

    <!-- Dual Edition Cards -->
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-8 items-stretch">
      <!-- Card 1: Self-Hosted / Open Source -->
      <div class="bg-[#141211] rounded-3xl border border-stone-800 p-8 sm:p-10 flex flex-col justify-between relative hover:border-stone-700 transition-colors">
        <div>
          <div class="flex items-center justify-between mb-6">
            <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-stone-800/80 border border-stone-700/60 text-stone-300 text-xs font-medium font-mono">
              GNU AGPLv3
            </span>
            <div class="w-10 h-10 rounded-xl bg-[#1C1A18] border border-stone-700/80 flex items-center justify-center text-stone-300">
              <Server class="w-5 h-5" />
            </div>
          </div>

          <h3 class="text-2xl font-bold text-white mb-2">Bebop Open Source</h3>
          <p class="text-stone-400 text-sm leading-relaxed mb-6">
            For developers and privacy-conscious teams who want full sovereignty over their content pipelines, databases, and infrastructure.
          </p>

          <div class="space-y-3.5 mb-8 text-xs text-stone-300">
            <div class="flex items-start gap-2.5">
              <Check class="w-4 h-4 text-emerald-400 shrink-0 mt-0.5" />
              <span><strong>100% Free & Open Source</strong> under GNU AGPLv3</span>
            </div>
            <div class="flex items-start gap-2.5">
              <Check class="w-4 h-4 text-emerald-400 shrink-0 mt-0.5" />
              <span>Deploy on your own VPS, Docker container, or local machine</span>
            </div>
            <div class="flex items-start gap-2.5">
              <Check class="w-4 h-4 text-emerald-400 shrink-0 mt-0.5" />
              <span>Full control over your PostgreSQL data, storage, and API keys</span>
            </div>
            <div class="flex items-start gap-2.5">
              <Check class="w-4 h-4 text-emerald-400 shrink-0 mt-0.5" />
              <span>Zero vendor telemetry, zero lock-in, clean Markdown exports</span>
            </div>
            <div class="flex items-start gap-2.5">
              <Check class="w-4 h-4 text-emerald-400 shrink-0 mt-0.5" />
              <span>Community extensions, custom adapters, and open roadmap</span>
            </div>
          </div>
        </div>

        <div class="pt-6 border-t border-stone-800/80 flex flex-col sm:flex-row items-center gap-3">
          <a
            href="https://github.com/ddri/bebop"
            target="_blank"
            rel="noopener noreferrer"
            class="w-full sm:w-auto inline-flex items-center justify-center gap-2 px-5 py-2.5 rounded-full border border-stone-700 bg-[#181615] text-stone-200 hover:bg-stone-800 hover:text-white text-xs font-semibold transition-colors"
          >
            <svg class="h-4 w-4" viewBox="0 0 24 24" fill="currentColor"><path d="M12 0C5.37 0 0 5.37 0 12c0 5.31 3.435 9.795 8.205 11.385.6.105.825-.255.825-.57 0-.285-.015-1.23-.015-2.235-3.015.555-3.795-.735-4.035-1.41-.135-.345-.72-1.41-1.23-1.695-.42-.225-1.02-.78-.015-.795.945-.015 1.62.87 1.845 1.23 1.08 1.815 2.805 1.305 3.495.99.105-.78.42-1.305.765-1.605-2.67-.3-5.46-1.335-5.46-5.925 0-1.305.465-2.385 1.23-3.225-.12-.3-.54-1.53.12-3.18 0 0 1.005-.315 3.3 1.23.96-.27 1.98-.405 3-.405s2.04.135 3 .405c2.295-1.56 3.3-1.23 3.3-1.23.66 1.65.24 2.88.12 3.18.765.84 1.23 1.905 1.23 3.225 0 4.605-2.805 5.625-5.475 5.925.435.375.81 1.095.81 2.22 0 1.605-.015 2.895-.015 3.3 0 .315.225.69.825.57A12.02 12.02 0 0 0 24 12c0-6.63-5.37-12-12-12z"/></svg>
            <span>Star on GitHub</span>
          </a>
          <a
            href="https://github.com/ddri/bebop#self-hosting"
            target="_blank"
            rel="noopener noreferrer"
            class="text-xs text-stone-400 hover:text-white transition-colors inline-flex items-center gap-1"
          >
            <span>Self-Hosting Guide</span>
            <span>&rarr;</span>
          </a>
        </div>
      </div>

      <!-- Card 2: Bebop Cloud (Hosted) -->
      <div class="bg-[#141211] rounded-3xl border border-pink/40 p-8 sm:p-10 flex flex-col justify-between relative shadow-lg shadow-pink/5 hover:border-pink/60 transition-colors">
        <div>
          <div class="flex items-center justify-between mb-6">
            <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-pink/20 border border-pink/40 text-pink text-xs font-semibold tracking-wide">
              Managed Cloud · Beta
            </span>
            <div class="w-10 h-10 rounded-xl bg-pink/15 text-pink flex items-center justify-center">
              <Cloud class="w-5 h-5" />
            </div>
          </div>

          <h3 class="text-2xl font-bold text-white mb-2">Bebop Cloud</h3>
          <p class="text-stone-400 text-sm leading-relaxed mb-6">
            For creators, marketing teams, and publications who want an instant collaborative studio with zero ops overhead.
          </p>

          <div class="space-y-3.5 mb-8 text-xs text-stone-300">
            <div class="flex items-start gap-2.5">
              <Check class="w-4 h-4 text-pink shrink-0 mt-0.5" />
              <span><strong>Zero maintenance</strong> — automated database backups, updates, and uptime</span>
            </div>
            <div class="flex items-start gap-2.5">
              <Check class="w-4 h-4 text-pink shrink-0 mt-0.5" />
              <span>Managed real-time multiplayer co-writing and live presence</span>
            </div>
            <div class="flex items-start gap-2.5">
              <Check class="w-4 h-4 text-pink shrink-0 mt-0.5" />
              <span>1-click verified OAuth for Hashnode, Dev.to, Bluesky, Mastodon</span>
            </div>
            <div class="flex items-start gap-2.5">
              <Check class="w-4 h-4 text-pink shrink-0 mt-0.5" />
              <span>Automated background queue with exponential rate-limit retries</span>
            </div>
            <div class="flex items-start gap-2.5">
              <Check class="w-4 h-4 text-pink shrink-0 mt-0.5" />
              <span>Secure encrypted token vault and high-speed global edge network</span>
            </div>
          </div>
        </div>

        <div class="pt-6 border-t border-stone-800/80 flex flex-col sm:flex-row items-center gap-3">
          <a
            href="#waitlist"
            class="w-full sm:w-auto inline-flex items-center justify-center gap-1.5 px-6 py-2.5 rounded-full bg-white text-stone-950 hover:bg-stone-200 text-xs font-semibold transition-all shadow-sm"
          >
            <span>Request Cloud Access</span>
            <span>&rarr;</span>
          </a>
          <span class="text-xs text-stone-400">Onboarding weekly cohorts</span>
        </div>
      </div>
    </div>
  </div>
</section>
