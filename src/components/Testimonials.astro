---
import { Server, Cloud, Check } from '@lucide/astro';
---

<section id="open-source" class="w-full py-24 border-t border-stone-800/80 bg-[#0A0908]">
  <div class="max-w-6xl mx-auto px-6">
    <div class="max-w-3xl mb-16 text-left">
      <h2 class="text-3xl sm:text-4xl font-bold text-white mb-4 tracking-tight font-sans">
        Two editions. Complete sovereignty. Zero lock-in.
      </h2>
      <p class="text-stone-400 text-base sm:text-lg leading-relaxed">
        Host the GNU AGPLv3 core on your own infrastructure, or launch on Bebop Cloud for managed real-time collaboration and edge delivery.
      </p>
    </div>

    <!-- Dual Edition Cards -->
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-8 items-stretch font-sans">
      <!-- Card 1: Self-Hosted / Open Source -->
      <div class="bg-[#141211] rounded-2xl border border-stone-800 p-8 flex flex-col justify-between hover:border-stone-700 transition-colors">
        <div>
          <div class="flex items-center justify-between mb-6">
            <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded bg-stone-900 border border-stone-800 text-stone-300 text-xs font-mono">
              GNU AGPLv3 Core
            </span>
            <div class="w-9 h-9 rounded-lg bg-[#1C1A18] border border-stone-700/80 flex items-center justify-center text-stone-300">
              <Server class="w-4 h-4" />
            </div>
          </div>

          <h3 class="text-2xl font-bold text-white mb-2">Bebop Community Edition</h3>
          <p class="text-stone-400 text-sm leading-relaxed mb-6">
            Self-host on your own VPS, Docker container, or private cloud. Full sovereignty over your PostgreSQL data, secrets, and outbound network.
          </p>

          <!-- Real Docker Terminal Snippet -->
          <div class="mb-6 p-3 rounded-lg bg-[#0D0B0A] border border-stone-800 font-mono text-xs text-stone-300">
            <div class="text-[10px] text-stone-500 mb-1.5">// Run locally in 30 seconds</div>
            <div class="text-emerald-400">$ git clone https://github.com/ddri/bebop.git</div>
            <div class="text-stone-400">$ cd bebop && docker compose up -d</div>
          </div>

          <div class="space-y-3 mb-8 text-xs text-stone-300">
            <div class="flex items-start gap-2.5">
              <Check class="w-4 h-4 text-emerald-400 shrink-0 mt-0.5" />
              <span><strong>100% Free Forever</strong> under GNU AGPLv3 license</span>
            </div>
            <div class="flex items-start gap-2.5">
              <Check class="w-4 h-4 text-emerald-400 shrink-0 mt-0.5" />
              <span>PostgreSQL schema with Prisma &bull; Bring your own DB</span>
            </div>
            <div class="flex items-start gap-2.5">
              <Check class="w-4 h-4 text-emerald-400 shrink-0 mt-0.5" />
              <span>Zero telemetry, zero cloud pings, strict privacy by design</span>
            </div>
            <div class="flex items-start gap-2.5">
              <Check class="w-4 h-4 text-emerald-400 shrink-0 mt-0.5" />
              <span>Full access to source code, REST endpoints, and custom adapters</span>
            </div>
          </div>
        </div>

        <div class="pt-6 border-t border-stone-800/80 flex flex-col sm:flex-row items-center gap-3 font-mono">
          <a
            href="https://github.com/ddri/bebop"
            target="_blank"
            rel="noopener noreferrer"
            class="w-full sm:w-auto inline-flex items-center justify-center gap-2 px-5 py-2.5 rounded-full border border-stone-700 bg-[#181615] text-stone-200 hover:bg-stone-800 hover:text-white text-xs font-semibold transition-colors"
          >
            <svg class="h-4 w-4" viewBox="0 0 24 24" fill="currentColor"><path d="M12 0C5.37 0 0 5.37 0 12c0 5.31 3.435 9.795 8.205 11.385.6.105.825-.255.825-.57 0-.285-.015-1.23-.015-2.235-3.015.555-3.795-.735-4.035-1.41-.135-.345-.72-1.41-1.23-1.695-.42-.225-1.02-.78-.015-.795.945-.015 1.62.87 1.845 1.23 1.08 1.815 2.805 1.305 3.495.99.105-.78.42-1.305.765-1.605-2.67-.3-5.46-1.335-5.46-5.925 0-1.305.465-2.385 1.23-3.225-.12-.3-.54-1.53.12-3.18 0 0 1.005-.315 3.3 1.23.96-.27 1.98-.405 3-.405s2.04.135 3 .405c2.295-1.56 3.3-1.23 3.3-1.23.66 1.65.24 2.88.12 3.18.765.84 1.23 1.905 1.23 3.225 0 4.605-2.805 5.625-5.475 5.925.435.375.81 1.095.81 2.22 0 1.605-.015 2.895-.015 3.3 0 .315.225.69.825.57A12.02 12.02 0 0 0 24 12c0-6.63-5.37-12-12-12z"/></svg>
            <span>Clone Repository</span>
          </a>
          <a
            href="https://github.com/ddri/bebop#self-hosting"
            target="_blank"
            rel="noopener noreferrer"
            class="text-xs text-stone-400 hover:text-white transition-colors inline-flex items-center gap-1"
          >
            <span>Self-Hosting Docs</span>
            <span>&rarr;</span>
          </a>
        </div>
      </div>

      <!-- Card 2: Bebop Cloud (Hosted) -->
      <div class="bg-[#141211] rounded-2xl border border-pink/40 p-8 flex flex-col justify-between hover:border-pink/60 transition-colors shadow-lg shadow-pink/5">
        <div>
          <div class="flex items-center justify-between mb-6">
            <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded bg-pink/20 border border-pink/40 text-pink text-xs font-mono font-semibold">
              Managed Cloud Beta
            </span>
            <div class="w-9 h-9 rounded-lg bg-pink/15 text-pink flex items-center justify-center">
              <Cloud class="w-4 h-4" />
            </div>
          </div>

          <h3 class="text-2xl font-bold text-white mb-2">Bebop Cloud</h3>
          <p class="text-stone-400 text-sm leading-relaxed mb-6">
            For technical content teams and marketing squads who want an instant collaborative workspace with zero ops overhead.
          </p>

          <!-- Cloud Highlights box -->
          <div class="mb-6 p-3 rounded-lg bg-[#181214] border border-pink/20 font-mono text-xs text-stone-300">
            <div class="text-[10px] text-pink mb-1.5">// Fully Managed Architecture</div>
            <div class="text-stone-300">&bull; High-speed global edge distribution</div>
            <div class="text-stone-300">&bull; Managed Postgres + automated backups</div>
          </div>

          <div class="space-y-3 mb-8 text-xs text-stone-300">
            <div class="flex items-start gap-2.5">
              <Check class="w-4 h-4 text-pink shrink-0 mt-0.5" />
              <span><strong>Zero server ops</strong> &bull; We manage uptime, updates, and DB backups</span>
            </div>
            <div class="flex items-start gap-2.5">
              <Check class="w-4 h-4 text-pink shrink-0 mt-0.5" />
              <span>1-click verified OAuth for Hashnode, Dev.to, Bluesky, Mastodon</span>
            </div>
            <div class="flex items-start gap-2.5">
              <Check class="w-4 h-4 text-pink shrink-0 mt-0.5" />
              <span>Real-time collaborative co-authoring & live team presence</span>
            </div>
            <div class="flex items-start gap-2.5">
              <Check class="w-4 h-4 text-pink shrink-0 mt-0.5" />
              <span>Encrypted token vault & continuous platform API adapter updates</span>
            </div>
          </div>
        </div>

        <div class="pt-6 border-t border-stone-800/80 flex flex-col sm:flex-row items-center gap-3">
          <a
            href="#waitlist"
            class="w-full sm:w-auto inline-flex items-center justify-center gap-1.5 px-6 py-2.5 rounded-full bg-white text-stone-950 hover:bg-stone-200 text-xs font-semibold transition-all shadow-sm font-sans"
          >
            <span>Request Cloud Access</span>
            <span>&rarr;</span>
          </a>
          <span class="text-xs text-stone-500 font-mono">Onboarding weekly cohorts</span>
        </div>
      </div>
    </div>
  </div>
</section>
