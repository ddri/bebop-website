---
---

<section class="relative w-full pt-16 pb-24 overflow-hidden">
  <div class="absolute inset-0 texture-dots pointer-events-none -z-10"></div>

  <div class="max-w-6xl mx-auto px-6 text-center">
    <!-- Release & License Bar -->
    <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full border border-stone-800 bg-[#12100E] text-xs text-stone-300 mb-8 font-mono">
      <span class="w-1.5 h-1.5 rounded-full bg-emerald-400"></span>
      <span class="text-stone-200 font-semibold">Bebop v0.3.5</span>
      <span class="text-stone-600">|</span>
      <span>Free & Open Source Core (AGPL-3.0)</span>
      <span class="text-stone-600">|</span>
      <a href="https://github.com/ddri/bebop" target="_blank" rel="noopener noreferrer" class="text-pink hover:underline">
        GitHub &rarr;
      </a>
    </div>

    <!-- Headline & Subtitle -->
    <h1 class="text-4xl sm:text-5xl lg:text-6xl font-bold text-white leading-[1.12] mb-6 max-w-4xl mx-auto font-sans tracking-tight">
      The campaign CMS for <br class="hidden sm:inline" />
      <span class="text-transparent bg-clip-text bg-gradient-to-r from-stone-100 via-stone-200 to-stone-400 font-serif italic font-normal">technical content teams.</span>
    </h1>

    <p class="text-lg sm:text-xl text-stone-400 max-w-3xl mx-auto leading-relaxed mb-8 font-sans">
      Plan multi-day launches in Markdown. Automatically format, schedule, and cross-publish across Hashnode, Dev.to, Beehiiv, Bluesky, and Mastodon with canonical URLs intact.
    </p>

    <!-- CTAs -->
    <div class="flex flex-col sm:flex-row gap-3.5 justify-center items-center mb-4">
      <a
        href="#waitlist"
        class="w-full sm:w-auto inline-flex items-center justify-center rounded-full text-sm font-semibold tracking-wide bg-white text-stone-950 hover:bg-stone-200 shadow-sm h-11 px-7 transition-all group"
      >
        <span>Deploy to Bebop Cloud</span>
        <span class="ml-1.5 group-hover:translate-x-0.5 transition-transform">&rarr;</span>
      </a>

      <a
        href="https://github.com/ddri/bebop"
        target="_blank"
        rel="noopener noreferrer"
        class="w-full sm:w-auto inline-flex items-center justify-center rounded-full text-sm font-medium border border-stone-800 bg-[#141211] text-stone-300 hover:bg-stone-800 hover:text-white h-11 px-6 shadow-2xs transition-colors gap-2"
      >
        <svg class="h-4 w-4" viewBox="0 0 24 24" fill="currentColor"><path d="M12 0C5.37 0 0 5.37 0 12c0 5.31 3.435 9.795 8.205 11.385.6.105.825-.255.825-.57 0-.285-.015-1.23-.015-2.235-3.015.555-3.795-.735-4.035-1.41-.135-.345-.72-1.41-1.23-1.695-.42-.225-1.02-.78-.015-.795.945-.015 1.62.87 1.845 1.23 1.08 1.815 2.805 1.305 3.495.99.105-.78.42-1.305.765-1.605-2.67-.3-5.46-1.335-5.46-5.925 0-1.305.465-2.385 1.23-3.225-.12-.3-.54-1.53.12-3.18 0 0 1.005-.315 3.3 1.23.96-.27 1.98-.405 3-.405s2.04.135 3 .405c2.295-1.56 3.3-1.23 3.3-1.23.66 1.65.24 2.88.12 3.18.765.84 1.23 1.905 1.23 3.225 0 4.605-2.805 5.625-5.475 5.925.435.375.81 1.095.81 2.22 0 1.605-.015 2.895-.015 3.3 0 .315.225.69.825.57A12.02 12.02 0 0 0 24 12c0-6.63-5.37-12-12-12z"/></svg>
        <span>Self-Host on GitHub</span>
        <span class="text-stone-600">·</span>
        <span class="text-stone-400 text-xs font-mono">AGPLv3</span>
      </a>
    </div>

    <p class="text-xs text-stone-500 max-w-xl mx-auto mb-12 font-mono">
      docker compose up -d &bull; Postgres &bull; Redis &bull; No vendor telemetry
    </p>

    <!-- Technical Orchestrator Interface Showcase -->
    <div class="relative mx-auto max-w-5xl text-left font-mono">
      <div class="rounded-xl border border-stone-800 bg-[#100E0D] editor-frame-shadow overflow-hidden">
        <!-- Workbench Toolbar -->
        <div class="h-10 bg-[#161413] border-b border-stone-800 px-4 flex items-center justify-between text-xs select-none">
          <div class="flex items-center gap-3">
            <span class="font-bold text-stone-200 tracking-wider">BEBOP ORCHESTRATOR</span>
            <span class="text-stone-600">/</span>
            <span class="text-stone-400">campaign: <span class="text-pink">q3-infrastructure-launch</span></span>
          </div>
          <div class="hidden sm:flex items-center gap-4 text-[11px] text-stone-400">
            <span class="flex items-center gap-1.5">
              <span id="hero-toolbar-dot" class="w-1.5 h-1.5 rounded-full bg-emerald-400"></span>
              <span id="hero-toolbar-count">2 of 3 Dispatched</span>
            </span>
            <span class="text-stone-600">|</span>
            <span>Target Matrix: 4 Platforms</span>
          </div>
        </div>

        <!-- Main Studio Grid -->
        <div class="grid grid-cols-12 min-h-[420px] text-xs divide-y md:divide-y-0 md:divide-x divide-stone-800">
          <!-- Column 1: Campaign Graph (3 cols) -->
          <div class="col-span-12 md:col-span-3 bg-[#0D0B0A] p-4 space-y-4">
            <div class="text-[10px] font-bold text-stone-400 uppercase tracking-widest">
              Release Sequence
            </div>

            <div class="space-y-2">
              <div class="p-2.5 rounded-md bg-[#161413] border border-stone-800/80">
                <div class="flex items-center justify-between text-[10px] text-stone-500 mb-1">
                  <span>DAY 01</span>
                  <span class="text-emerald-400 font-semibold">DISPATCHED</span>
                </div>
                <div class="font-medium text-stone-200 truncate">01-vision-and-core.md</div>
                <div class="text-[10px] text-stone-500 mt-1">Hashnode &bull; Dev.to &bull; Bluesky</div>
              </div>

              <div class="p-2.5 rounded-md bg-[#1A1614] border border-pink/50">
                <div class="flex items-center justify-between text-[10px] text-pink mb-1 font-semibold">
                  <span>DAY 02 (ACTIVE)</span>
                  <span id="hero-day2-badge" class="text-amber-400">READY</span>
                </div>
                <div class="font-medium text-stone-100 truncate">02-distributed-queue.md</div>
                <div id="hero-day2-sub" class="text-[10px] text-stone-400 mt-1">All 4 destinations queued</div>
              </div>

              <div class="p-2.5 rounded-md bg-[#12100F] border border-stone-850 text-stone-500">
                <div class="flex items-center justify-between text-[10px] text-stone-600 mb-1">
                  <span>DAY 03</span>
                  <span>PENDING</span>
                </div>
                <div class="font-medium text-stone-400 truncate">03-latency-benchmarks.md</div>
                <div class="text-[10px] text-stone-600 mt-1">Scheduled for Thu 14:00</div>
              </div>
            </div>

            <div class="pt-2 border-t border-stone-850">
              <div class="text-[10px] text-stone-400 uppercase tracking-wider mb-1 font-semibold">Engine Pipeline</div>
              <div class="text-[11px] text-stone-300 font-sans leading-relaxed">
                Canonical URLs are computed from your primary blog domain and verified before dispatch.
              </div>
            </div>
          </div>

          <!-- Column 2: Markdown & Platform Payload Inspector (6 cols) -->
          <div class="col-span-12 md:col-span-6 bg-[#100E0D] p-5 flex flex-col justify-between">
            <div class="space-y-3 font-mono text-[11px] leading-relaxed">
              <!-- Synchronized Inspector Tab Bar -->
              <div class="flex flex-wrap items-center justify-between gap-2 pb-2.5 border-b border-stone-800">
                <div class="flex flex-wrap items-center gap-1" role="tablist" aria-label="Payload Inspector Tabs">
                  <button
                    type="button"
                    role="tab"
                    aria-selected="true"
                    data-hero-tab-btn="source"
                    class="px-2 py-1 rounded text-[10px] font-semibold transition-all cursor-pointer bg-pink/15 text-pink border border-pink/40"
                  >
                    Source (.md)
                  </button>
                  <button
                    type="button"
                    role="tab"
                    aria-selected="false"
                    data-hero-tab-btn="hashnode"
                    class="px-2 py-1 rounded text-[10px] font-medium transition-all cursor-pointer text-stone-400 hover:text-stone-200 border border-transparent hover:border-stone-800"
                  >
                    Hashnode
                  </button>
                  <button
                    type="button"
                    role="tab"
                    aria-selected="false"
                    data-hero-tab-btn="devto"
                    class="px-2 py-1 rounded text-[10px] font-medium transition-all cursor-pointer text-stone-400 hover:text-stone-200 border border-transparent hover:border-stone-800"
                  >
                    Dev.to
                  </button>
                  <button
                    type="button"
                    role="tab"
                    aria-selected="false"
                    data-hero-tab-btn="beehiiv"
                    class="px-2 py-1 rounded text-[10px] font-medium transition-all cursor-pointer text-stone-400 hover:text-stone-200 border border-transparent hover:border-stone-800"
                  >
                    Beehiiv
                  </button>
                  <button
                    type="button"
                    role="tab"
                    aria-selected="false"
                    data-hero-tab-btn="bluesky"
                    class="px-2 py-1 rounded text-[10px] font-medium transition-all cursor-pointer text-stone-400 hover:text-stone-200 border border-transparent hover:border-stone-800"
                  >
                    Bluesky
                  </button>
                </div>
                <span id="hero-editor-mode" class="text-[10px] text-emerald-400">Markdown UTF-8</span>
              </div>

              <!-- Panel 1: Source (.md) -->
              <div data-hero-panel="source" class="space-y-3">
                <div class="flex items-center justify-between text-[10px] text-stone-400">
                  <span>FILE: content/campaigns/02-distributed-queue.md</span>
                  <span class="text-stone-500">raw source</span>
                </div>

                <!-- Frontmatter block with syntax colors -->
                <div class="p-3 rounded bg-[#0A0908] border border-stone-800/80 text-stone-300 font-mono text-[11px]">
                  <span class="text-stone-500">---</span><br />
                  <span class="text-pink">title</span>: <span class="text-emerald-300">"Inside the Distributed Content Queue"</span><br />
                  <span class="text-pink">canonical_url</span>: <span class="text-sky-300">"https://acme.dev/blog/distributed-queue"</span><br />
                  <span class="text-pink">tags</span>: <span class="text-amber-200">["architecture", "devrel", "queues"]</span><br />
                  <span class="text-pink">targets</span>:<br />
                  &nbsp;&nbsp;<span class="text-purple-300">hashnode</span>: &#123; <span class="text-stone-400">canonical: true, draft: false</span> &#125;<br />
                  &nbsp;&nbsp;<span class="text-purple-300">devto</span>: &#123; <span class="text-stone-400">series: "Q3 Launch", canonical: true</span> &#125;<br />
                  &nbsp;&nbsp;<span class="text-purple-300">beehiiv</span>: &#123; <span class="text-stone-400">newsletter_template: "deep-dive"</span> &#125;<br />
                  &nbsp;&nbsp;<span class="text-purple-300">bluesky</span>: &#123; <span class="text-stone-400">thread_split: "headings", max_posts: 4</span> &#125;<br />
                  <span class="text-stone-500">---</span>
                </div>

                <!-- Technical markdown excerpt -->
                <div class="text-stone-300 pt-1">
                  <span class="text-stone-500">##</span> <span class="text-white font-bold">Why Cross-Posting Breaks Technical SEO</span><br />
                  When technical teams publish to Dev.to, Hashnode, and corporate blogs without automated canonical headers, Google splits page rank across scrapers. Bebop injects verified canonical tags directly into each platform payload...
                </div>
              </div>

              <!-- Panel 2: Hashnode GraphQL Payload -->
              <div data-hero-panel="hashnode" class="hidden space-y-3">
                <div class="flex items-center justify-between text-[10px] text-stone-400">
                  <span>POST https://gql.hashnode.com &bull; <span class="text-blue-400">PublishPostInput</span></span>
                  <span class="text-emerald-400">Canonical Injected</span>
                </div>

                <div class="p-3 rounded bg-[#0A0908] border border-stone-800/80 text-stone-300 font-mono text-[11px] space-y-0.5">
                  <div><span class="text-purple-300">mutation</span> <span class="text-sky-300">PublishPost</span>(<span class="text-amber-200">$input</span>: <span class="text-emerald-300">PublishPostInput!</span>) &#123;</div>
                  <div>&nbsp;&nbsp;<span class="text-pink">publicationId</span>: <span class="text-emerald-300">"64f1a9c0e4b09b1d8a32c104"</span>,</div>
                  <div>&nbsp;&nbsp;<span class="text-pink">title</span>: <span class="text-emerald-300">"Inside the Distributed Content Queue"</span>,</div>
                  <div>&nbsp;&nbsp;<span class="text-pink">subtitle</span>: <span class="text-emerald-300">"How we guarantee idempotent multi-platform dispatch"</span>,</div>
                  <div>&nbsp;&nbsp;<span class="text-pink">slug</span>: <span class="text-emerald-300">"distributed-queue"</span>,</div>
                  <div>&nbsp;&nbsp;<span class="text-pink">originalArticleURL</span>: <span class="text-sky-300">"https://acme.dev/blog/distributed-queue"</span>,</div>
                  <div>&nbsp;&nbsp;<span class="text-pink">tags</span>: [&#123; <span class="text-stone-400">slug: "architecture"</span> &#125;, &#123; <span class="text-stone-400">slug: "distributed-systems"</span> &#125;],</div>
                  <div>&nbsp;&nbsp;<span class="text-pink">contentMarkdown</span>: <span class="text-stone-400">"## Why Cross-Posting Breaks Technical SEO\n..."</span></div>
                  <div>&#125;</div>
                </div>

                <div class="p-2.5 rounded bg-blue-950/20 border border-blue-900/40 text-[10px] text-stone-300 flex items-center justify-between">
                  <span><span class="text-blue-400 font-semibold">AST Adapter:</span> Stripped local MDX imports &amp; resolved relative asset URLs</span>
                  <span class="text-emerald-400 font-semibold">SCHEMA OK</span>
                </div>
              </div>

              <!-- Panel 3: Dev.to Forem REST Payload -->
              <div data-hero-panel="devto" class="hidden space-y-3">
                <div class="flex items-center justify-between text-[10px] text-stone-400">
                  <span>POST https://dev.to/api/articles &bull; <span class="text-stone-200">Forem REST v1</span></span>
                  <span class="text-emerald-400">Liquid Tags Adapted</span>
                </div>

                <div class="p-3 rounded bg-[#0A0908] border border-stone-800/80 text-stone-300 font-mono text-[11px] space-y-0.5">
                  <div>&#123; <span class="text-pink">"article"</span>: &#123;</div>
                  <div>&nbsp;&nbsp;<span class="text-pink">"title"</span>: <span class="text-emerald-300">"Inside the Distributed Content Queue"</span>,</div>
                  <div>&nbsp;&nbsp;<span class="text-pink">"published"</span>: <span class="text-amber-300">true</span>,</div>
                  <div>&nbsp;&nbsp;<span class="text-pink">"series"</span>: <span class="text-emerald-300">"Q3 Launch Week"</span>,</div>
                  <div>&nbsp;&nbsp;<span class="text-pink">"canonical_url"</span>: <span class="text-sky-300">"https://acme.dev/blog/distributed-queue"</span>,</div>
                  <div>&nbsp;&nbsp;<span class="text-pink">"tags"</span>: [<span class="text-amber-200">"architecture"</span>, <span class="text-amber-200">"devrel"</span>, <span class="text-amber-200">"queues"</span>],</div>
                  <div>&nbsp;&nbsp;<span class="text-pink">"body_markdown"</span>: <span class="text-stone-400">"&#123;% github ddri/bebop %&#125;\n## Why Cross-Posting..."</span></div>
                  <div>&#125; &#125;</div>
                </div>

                <div class="p-2.5 rounded bg-emerald-950/20 border border-emerald-900/40 text-[10px] text-stone-300 flex items-center justify-between">
                  <span><span class="text-emerald-400 font-semibold">Transform:</span> Converted GitHub repo embeds to Forem <code class="text-pink">&#123;% github %&#125;</code> Liquid tags</span>
                  <span class="text-emerald-400 font-semibold">VERIFIED</span>
                </div>
              </div>

              <!-- Panel 4: Beehiiv Newsletter Payload -->
              <div data-hero-panel="beehiiv" class="hidden space-y-3">
                <div class="flex items-center justify-between text-[10px] text-stone-400">
                  <span>POST /v2/publications/pub_89a/posts &bull; <span class="text-amber-400">template: "deep-dive"</span></span>
                  <span class="text-amber-400">Thu 09:00 UTC</span>
                </div>

                <div class="p-3 rounded bg-[#0A0908] border border-stone-800/80 text-stone-300 font-mono text-[11px] space-y-1">
                  <div><span class="text-pink">subject_line</span>: <span class="text-emerald-300">"[Deep Dive] Inside the Distributed Content Queue"</span></div>
                  <div><span class="text-pink">preview_text</span>: <span class="text-stone-300">"How we synchronize canonical SEO across 4 developer platforms."</span></div>
                  <div><span class="text-pink">segment_ids</span>: [<span class="text-amber-200">"seg_eng_subscribers"</span>, <span class="text-amber-200">"seg_launch_waitlist"</span>]</div>
                  <div class="pt-1.5 mt-1.5 border-t border-stone-800/80 text-[10px] font-sans text-stone-300 bg-[#141210] p-2 rounded">
                    <div class="text-stone-400 font-mono text-[9px] uppercase tracking-wider mb-0.5">Compiled Email Callout Footer</div>
                    Read the interactive benchmark diagrams on our engineering blog:
                    <span class="text-pink underline">acme.dev/blog/distributed-queue?utm_source=beehiiv&amp;utm_campaign=q3_launch</span>
                  </div>
                </div>

                <div class="p-2.5 rounded bg-amber-950/20 border border-amber-900/40 text-[10px] text-stone-300 flex items-center justify-between">
                  <span><span class="text-amber-400 font-semibold">Email Compiler:</span> Inlined CSS tables + injected UTM canonical footer</span>
                  <span class="text-amber-400 font-semibold">QUEUED</span>
                </div>
              </div>

              <!-- Panel 5: Bluesky AT Protocol Thread Splitter -->
              <div data-hero-panel="bluesky" class="hidden space-y-2.5">
                <div class="flex items-center justify-between text-[10px] text-stone-400">
                  <span>xrpc/com.atproto.repo.createRecord &bull; <span class="text-sky-400">app.bsky.feed.post</span></span>
                  <span class="text-sky-400">3 Linked Records</span>
                </div>

                <div class="space-y-1.5 text-[10px]">
                  <div class="p-2 rounded bg-[#0A0908] border border-stone-800/80">
                    <div class="flex items-center justify-between text-stone-400 mb-0.5">
                      <span class="text-sky-400 font-semibold">Post 1/3 (Root) &bull; cid:bafyreih7...2q</span>
                      <span class="text-emerald-400">284 / 300 chars</span>
                    </div>
                    <div class="text-stone-200 font-sans">
                      Why does cross-posting break technical SEO? When engineering teams publish to Dev.to &amp; Hashnode without strict canonical headers, search engines split page rank. Here is how we built Bebop's queue &#129525;
                    </div>
                  </div>

                  <div class="p-2 rounded bg-[#0A0908] border border-stone-800/80">
                    <div class="flex items-center justify-between text-stone-400 mb-0.5">
                      <span class="text-purple-300 font-semibold">Post 2/3 (Reply &rarr; 1/3) &bull; cid:bafyreia4...9k</span>
                      <span class="text-emerald-400">261 / 300 chars</span>
                    </div>
                    <div class="text-stone-200 font-sans">
                      Each Markdown file compiles through an AST pipeline: stripping incompatible MDX tags for Hashnode, injecting Forem Liquid blocks for Dev.to, and generating rich-text byte facets for AT Protocol.
                    </div>
                  </div>

                  <div class="p-2 rounded bg-[#0A0908] border border-stone-800/80">
                    <div class="flex items-center justify-between text-stone-400 mb-0.5">
                      <span class="text-pink font-semibold">Post 3/3 (Canonical Facet) &bull; cid:bafyreib8...4m</span>
                      <span class="text-emerald-400">198 / 300 chars</span>
                    </div>
                    <div class="text-stone-200 font-sans">
                      Full architecture walkthrough &amp; queue benchmarks on our canonical post: <span class="text-sky-400 underline">acme.dev/blog/distributed-queue</span>
                    </div>
                  </div>
                </div>
              </div>
            </div>

            <!-- Terminal status bar -->
            <div class="mt-4 pt-3 border-t border-stone-800/80 flex items-center justify-between text-[10px] text-stone-500 font-mono">
              <span id="hero-status-left">Branch: feat/launch-content</span>
              <span id="hero-status-right" class="text-stone-400">AST parser: OK &bull; Word count: 1,420</span>
            </div>
          </div>

          <!-- Column 3: Multi-Platform Payload Inspector (3 cols) -->
          <div class="col-span-12 md:col-span-3 bg-[#0D0B0A] p-4 space-y-2.5 font-mono flex flex-col justify-between">
            <div class="space-y-2.5">
              <div class="flex items-center justify-between">
                <span class="text-[10px] font-bold text-stone-400 uppercase tracking-widest">
                  Destination Payloads
                </span>
                <span class="text-[9px] text-pink/90 tracking-tight">
                  Click to inspect
                </span>
              </div>

              <!-- Target 1: Hashnode -->
              <button
                type="button"
                data-hero-card="hashnode"
                class="w-full text-left p-2.5 rounded bg-[#141211] border border-stone-800 hover:border-stone-600 transition-all cursor-pointer group"
              >
                <div class="flex items-center justify-between text-[11px] font-semibold mb-1">
                  <span class="text-blue-400 group-hover:text-blue-300 flex items-center gap-1.5">
                    <span data-hero-card-dot="hashnode" class="w-1.5 h-1.5 rounded-full bg-stone-600 transition-colors"></span>
                    Hashnode API
                  </span>
                  <span data-hero-card-badge="hashnode" data-default-text="200 READY" class="text-[10px] text-emerald-400 bg-emerald-950/60 px-1.5 py-0.5 rounded border border-emerald-800/40">200 READY</span>
                </div>
                <div class="text-[10px] text-stone-400">Canonical: acme.dev/...</div>
                <div class="text-[10px] text-stone-500 mt-0.5">Slug: /distributed-queue</div>
              </button>

              <!-- Target 2: Dev.to -->
              <button
                type="button"
                data-hero-card="devto"
                class="w-full text-left p-2.5 rounded bg-[#141211] border border-stone-800 hover:border-stone-600 transition-all cursor-pointer group"
              >
                <div class="flex items-center justify-between text-[11px] font-semibold mb-1">
                  <span class="text-stone-200 group-hover:text-white flex items-center gap-1.5">
                    <span data-hero-card-dot="devto" class="w-1.5 h-1.5 rounded-full bg-stone-600 transition-colors"></span>
                    Dev.to API
                  </span>
                  <span data-hero-card-badge="devto" data-default-text="VERIFIED" class="text-[10px] text-emerald-400 bg-emerald-950/60 px-1.5 py-0.5 rounded border border-emerald-800/40">VERIFIED</span>
                </div>
                <div class="text-[10px] text-stone-400">Canonical tag matched</div>
                <div class="text-[10px] text-stone-500 mt-0.5">Series: Q3 Launch Week</div>
              </button>

              <!-- Target 3: Beehiiv -->
              <button
                type="button"
                data-hero-card="beehiiv"
                class="w-full text-left p-2.5 rounded bg-[#141211] border border-stone-800 hover:border-stone-600 transition-all cursor-pointer group"
              >
                <div class="flex items-center justify-between text-[11px] font-semibold mb-1">
                  <span class="text-amber-400 group-hover:text-amber-300 flex items-center gap-1.5">
                    <span data-hero-card-dot="beehiiv" class="w-1.5 h-1.5 rounded-full bg-stone-600 transition-colors"></span>
                    Beehiiv Newsletter
                  </span>
                  <span data-hero-card-badge="beehiiv" data-default-text="QUEUED" class="text-[10px] text-amber-400 bg-amber-950/60 px-1.5 py-0.5 rounded border border-amber-800/40">QUEUED</span>
                </div>
                <div class="text-[10px] text-stone-400">HTML email generated</div>
                <div class="text-[10px] text-stone-500 mt-0.5">Scheduled for Thu 09:00</div>
              </button>

              <!-- Target 4: Bluesky -->
              <button
                type="button"
                data-hero-card="bluesky"
                class="w-full text-left p-2.5 rounded bg-[#141211] border border-stone-800 hover:border-stone-600 transition-all cursor-pointer group"
              >
                <div class="flex items-center justify-between text-[11px] font-semibold mb-1">
                  <span class="text-sky-400 group-hover:text-sky-300 flex items-center gap-1.5">
                    <span data-hero-card-dot="bluesky" class="w-1.5 h-1.5 rounded-full bg-stone-600 transition-colors"></span>
                    Bluesky AT Protocol
                  </span>
                  <span data-hero-card-badge="bluesky" data-default-text="3 POSTS" class="text-[10px] text-sky-400 bg-sky-950/60 px-1.5 py-0.5 rounded border border-sky-800/40">3 POSTS</span>
                </div>
                <div class="text-[10px] text-stone-400">Thread split validated</div>
                <div class="text-[10px] text-stone-500 mt-0.5">Root post + 2 replies</div>
              </button>
            </div>

            <!-- Trigger Action Button -->
            <div class="pt-2">
              <button
                type="button"
                id="hero-dispatch-btn"
                class="w-full py-2 px-3 rounded bg-white text-stone-950 text-center font-bold text-xs hover:bg-stone-200 transition-colors cursor-pointer font-sans"
              >
                Execute Dispatch (All 4)
              </button>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  type TabKey = 'source' | 'hashnode' | 'devto' | 'beehiiv' | 'bluesky';

  const TAB_META: Record<TabKey, { mode: string; left: string; right: string }> = {
    source: {
      mode: 'Markdown UTF-8',
      left: 'Branch: feat/launch-content',
      right: 'AST parser: OK • Word count: 1,420',
    },
    hashnode: {
      mode: 'GraphQL Mutation',
      left: 'Target: gql.hashnode.com',
      right: 'originalArticleURL: verified • 200 READY',
    },
    devto: {
      mode: 'Forem REST JSON',
      left: 'Target: dev.to/api/articles',
      right: 'canonical_url: matched • Liquid AST OK',
    },
    beehiiv: {
      mode: 'HTML + UTM Compiler',
      left: 'Target: api.beehiiv.com/v2',
      right: 'Template: deep-dive • Thu 09:00 UTC',
    },
    bluesky: {
      mode: 'AT Protocol XRPC',
      left: 'Target: bsky.social (3 records)',
      right: 'Byte facets: valid • Max 284/300 chars',
    },
  };

  const tabButtons = document.querySelectorAll<HTMLButtonElement>('[data-hero-tab-btn]');
  const panels = document.querySelectorAll<HTMLElement>('[data-hero-panel]');
  const cards = document.querySelectorAll<HTMLButtonElement>('[data-hero-card]');
  const editorMode = document.getElementById('hero-editor-mode');
  const statusLeft = document.getElementById('hero-status-left');
  const statusRight = document.getElementById('hero-status-right');

  let activeTab: TabKey = 'source';

  function selectHeroTab(nextTab: TabKey) {
    activeTab = nextTab;

    tabButtons.forEach((btn) => {
      const key = btn.getAttribute('data-hero-tab-btn') as TabKey | null;
      const isSelected = key === activeTab;
      btn.setAttribute('aria-selected', isSelected ? 'true' : 'false');
      if (isSelected) {
        btn.className =
          'px-2 py-1 rounded text-[10px] font-semibold transition-all cursor-pointer bg-pink/15 text-pink border border-pink/40';
      } else {
        btn.className =
          'px-2 py-1 rounded text-[10px] font-medium transition-all cursor-pointer text-stone-400 hover:text-stone-200 border border-transparent hover:border-stone-800';
      }
    });

    panels.forEach((panel) => {
      const key = panel.getAttribute('data-hero-panel');
      panel.classList.toggle('hidden', key !== activeTab);
    });

    cards.forEach((card) => {
      const key = card.getAttribute('data-hero-card');
      const isSelected = key === activeTab;
      const dot = card.querySelector<HTMLElement>('[data-hero-card-dot]');
      if (isSelected) {
        card.className =
          'w-full text-left p-2.5 rounded bg-[#1A1517] border border-pink transition-all cursor-pointer group shadow-2xs';
        if (dot) {
          dot.className = 'w-1.5 h-1.5 rounded-full bg-pink transition-colors';
        }
      } else {
        card.className =
          'w-full text-left p-2.5 rounded bg-[#141211] border border-stone-800 hover:border-stone-600 transition-all cursor-pointer group';
        if (dot) {
          dot.className = 'w-1.5 h-1.5 rounded-full bg-stone-600 transition-colors';
        }
      }
    });

    const meta = TAB_META[activeTab];
    if (editorMode) editorMode.textContent = meta.mode;
    if (statusLeft) statusLeft.textContent = meta.left;
    if (statusRight) statusRight.textContent = meta.right;
  }

  tabButtons.forEach((btn) => {
    btn.addEventListener('click', () => {
      const key = btn.getAttribute('data-hero-tab-btn') as TabKey | null;
      if (key) selectHeroTab(key);
    });
  });

  cards.forEach((card) => {
    card.addEventListener('click', () => {
      const key = card.getAttribute('data-hero-card') as TabKey | null;
      if (!key) return;
      // Clicking an already-active card toggles back to raw Markdown source
      selectHeroTab(activeTab === key ? 'source' : key);
    });
  });

  // Interactive Execute Dispatch button
  const dispatchBtn = document.getElementById('hero-dispatch-btn') as HTMLButtonElement | null;
  const day2Badge = document.getElementById('hero-day2-badge');
  const day2Sub = document.getElementById('hero-day2-sub');
  const toolbarCount = document.getElementById('hero-toolbar-count');
  let isDispatched = false;

  if (dispatchBtn) {
    dispatchBtn.addEventListener('click', () => {
      isDispatched = !isDispatched;
      const badges = document.querySelectorAll<HTMLElement>('[data-hero-card-badge]');

      if (isDispatched) {
        dispatchBtn.textContent = '✓ All 4 Payloads Dispatched (Reset)';
        dispatchBtn.className =
          'w-full py-2 px-3 rounded bg-emerald-500/20 text-emerald-300 border border-emerald-500/40 text-center font-bold text-xs hover:bg-emerald-500/30 transition-colors cursor-pointer font-sans';
        if (day2Badge) {
          day2Badge.textContent = 'DISPATCHED';
          day2Badge.className = 'text-emerald-400';
        }
        if (day2Sub) {
          day2Sub.textContent = '4/4 canonical URLs live';
        }
        if (toolbarCount) {
          toolbarCount.textContent = '3 of 3 Dispatched';
        }
        badges.forEach((badge) => {
          badge.textContent = '200 DISPATCHED';
          badge.className =
            'text-[10px] text-emerald-400 bg-emerald-950/60 px-1.5 py-0.5 rounded border border-emerald-800/40';
        });
      } else {
        dispatchBtn.textContent = 'Execute Dispatch (All 4)';
        dispatchBtn.className =
          'w-full py-2 px-3 rounded bg-white text-stone-950 text-center font-bold text-xs hover:bg-stone-200 transition-colors cursor-pointer font-sans';
        if (day2Badge) {
          day2Badge.textContent = 'READY';
          day2Badge.className = 'text-amber-400';
        }
        if (day2Sub) {
          day2Sub.textContent = 'All 4 destinations queued';
        }
        if (toolbarCount) {
          toolbarCount.textContent = '2 of 3 Dispatched';
        }
        badges.forEach((badge) => {
          const key = badge.getAttribute('data-hero-card-badge');
          const defaultText = badge.getAttribute('data-default-text') || 'READY';
          badge.textContent = defaultText;
          if (key === 'beehiiv') {
            badge.className =
              'text-[10px] text-amber-400 bg-amber-950/60 px-1.5 py-0.5 rounded border border-amber-800/40';
          } else if (key === 'bluesky') {
            badge.className =
              'text-[10px] text-sky-400 bg-sky-950/60 px-1.5 py-0.5 rounded border border-sky-800/40';
          } else {
            badge.className =
              'text-[10px] text-emerald-400 bg-emerald-950/60 px-1.5 py-0.5 rounded border border-emerald-800/40';
          }
        });
      }
    });
  }
</script>
