---
---

<section class="relative w-full pt-16 pb-24 overflow-hidden">
  <!-- Subtle ambient background glow -->
  <div class="absolute top-0 left-1/2 -translate-x-1/2 w-[800px] h-[350px] bg-pink/10 blur-[120px] pointer-events-none -z-10 rounded-full"></div>
  <div class="absolute inset-0 texture-noise pointer-events-none -z-10"></div>

  <div class="max-w-6xl mx-auto px-6 text-center">
    <!-- Release Badge -->
    <a
      href="https://github.com/ddri/bebop/releases/tag/v0.3.5"
      target="_blank"
      rel="noopener noreferrer"
      class="inline-flex items-center gap-2.5 px-3.5 py-1.5 rounded-full border border-stone-200 bg-white shadow-2xs hover:border-pink/40 hover:bg-stone-50 transition-all text-xs text-stone-700 mb-8"
    >
      <span class="w-2 h-2 rounded-full bg-pink animate-pulse"></span>
      <span class="font-medium text-stone-900">v0.3.5 is now available</span>
      <span class="text-stone-400">·</span>
      <span class="text-stone-500">Read release notes</span>
      <span class="text-stone-400">&rarr;</span>
    </a>

    <!-- Headline & Subtitle -->
    <h1 class="text-4xl sm:text-5xl lg:text-6xl font-bold text-stone-900 leading-[1.12] mb-6 max-w-4xl mx-auto">
      Your content campaigns, <br class="hidden sm:inline" />
      <span class="italic font-normal text-stone-800">in one focused space.</span>
    </h1>

    <p class="text-lg sm:text-xl text-stone-600 max-w-2xl mx-auto leading-relaxed mb-9">
      Draft in a real-time collaborative editor. Automatically format, schedule, and publish across Hashnode, Dev.to, Bluesky, and Mastodon.
    </p>

    <!-- CTAs -->
    <div class="flex flex-col sm:flex-row gap-3.5 justify-center items-center mb-16">
      <a
        href="#waitlist"
        class="w-full sm:w-auto inline-flex items-center justify-center rounded-full text-sm font-semibold tracking-wide bg-stone-900 text-stone-50 hover:bg-stone-800 shadow-sm h-11 px-7 transition-all group"
      >
        <span>Request Early Access</span>
        <span class="ml-1.5 group-hover:translate-x-0.5 transition-transform">&rarr;</span>
      </a>

      <a
        href="https://github.com/ddri/bebop"
        target="_blank"
        rel="noopener noreferrer"
        class="w-full sm:w-auto inline-flex items-center justify-center rounded-full text-sm font-medium border border-stone-300/80 bg-white text-stone-700 hover:bg-stone-50 hover:text-stone-900 h-11 px-6 shadow-2xs transition-colors gap-2"
      >
        <svg class="h-4 w-4" viewBox="0 0 24 24" fill="currentColor"><path d="M12 0C5.37 0 0 5.37 0 12c0 5.31 3.435 9.795 8.205 11.385.6.105.825-.255.825-.57 0-.285-.015-1.23-.015-2.235-3.015.555-3.795-.735-4.035-1.41-.135-.345-.72-1.41-1.23-1.695-.42-.225-1.02-.78-.015-.795.945-.015 1.62.87 1.845 1.23 1.08 1.815 2.805 1.305 3.495.99.105-.78.42-1.305.765-1.605-2.67-.3-5.46-1.335-5.46-5.925 0-1.305.465-2.385 1.23-3.225-.12-.3-.54-1.53.12-3.18 0 0 1.005-.315 3.3 1.23.96-.27 1.98-.405 3-.405s2.04.135 3 .405c2.295-1.56 3.3-1.23 3.3-1.23.66 1.65.24 2.88.12 3.18.765.84 1.23 1.905 1.23 3.225 0 4.605-2.805 5.625-5.475 5.925.435.375.81 1.095.81 2.22 0 1.605-.015 2.895-.015 3.3 0 .315.225.69.825.57A12.02 12.02 0 0 0 24 12c0-6.63-5.37-12-12-12z"/></svg>
        <span>Star on GitHub</span>
        <span class="text-stone-400">·</span>
        <span class="text-stone-500 text-xs">v0.3.5</span>
      </a>
    </div>

    <!-- Product Visual: Rendered Bebop Studio Editor Mockup -->
    <div class="relative mx-auto max-w-5xl text-left">
      <div class="rounded-xl border border-stone-200/90 bg-white editor-frame-shadow overflow-hidden">
        <!-- Window Titlebar -->
        <div class="h-11 bg-stone-100/90 border-b border-stone-200 px-4 flex items-center justify-between select-none">
          <div class="flex items-center gap-2">
            <span class="w-3 h-3 rounded-full bg-[#FF5F56] border border-[#E0443E]/50 inline-block"></span>
            <span class="w-3 h-3 rounded-full bg-[#FFBD2E] border border-[#DEA123]/50 inline-block"></span>
            <span class="w-3 h-3 rounded-full bg-[#27C93F] border border-[#1AAB29]/50 inline-block"></span>
          </div>
          <div class="text-xs font-medium text-stone-500 flex items-center gap-1.5">
            <svg class="w-3.5 h-3.5 text-stone-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <rect x="3" y="3" width="18" height="18" rx="2" ry="2"></rect>
              <line x1="9" y1="3" x2="9" y2="21"></line>
            </svg>
            <span>Bebop Studio — <strong>Q3 Launch Campaign</strong></span>
          </div>
          <div class="flex items-center gap-2 text-xs">
            <span class="inline-flex items-center gap-1 px-2 py-0.5 rounded-full bg-emerald-50 text-emerald-700 border border-emerald-200/60 font-medium text-[11px]">
              <span class="w-1.5 h-1.5 rounded-full bg-emerald-500"></span> Live Presence
            </span>
          </div>
        </div>

        <!-- Studio Workspace Columns -->
        <div class="grid grid-cols-12 min-h-[380px] bg-white text-xs divide-x divide-stone-100">
          <!-- Left Column: Campaign Navigation (hidden on smallest screens) -->
          <div class="hidden md:block md:col-span-3 bg-stone-50/70 p-4 font-sans select-none">
            <div class="text-[11px] font-semibold text-stone-400 uppercase tracking-wider mb-3">
              Campaigns
            </div>
            <div class="space-y-1 mb-6">
              <div class="px-2.5 py-1.5 rounded-md bg-stone-200/70 text-stone-900 font-medium flex items-center justify-between">
                <span class="truncate">Q3 Launch Week</span>
                <span class="text-[10px] px-1.5 py-0.2 rounded bg-pink/20 text-pink font-semibold">3 posts</span>
              </div>
              <div class="px-2.5 py-1.5 rounded-md text-stone-600 hover:bg-stone-100 flex items-center justify-between">
                <span class="truncate">Engineering Handbooks</span>
                <span class="text-[10px] text-stone-400">5 posts</span>
              </div>
              <div class="px-2.5 py-1.5 rounded-md text-stone-600 hover:bg-stone-100 flex items-center justify-between">
                <span class="truncate">Bi-weekly Changelog</span>
                <span class="text-[10px] text-stone-400">12 posts</span>
              </div>
            </div>

            <div class="text-[11px] font-semibold text-stone-400 uppercase tracking-wider mb-2">
              Campaign Posts
            </div>
            <div class="space-y-1">
              <div class="px-2.5 py-1.5 rounded text-stone-500 flex items-center gap-2">
                <span class="w-1.5 h-1.5 rounded-full bg-stone-300"></span>
                <span class="truncate">1. Launch Announcement</span>
              </div>
              <div class="px-2.5 py-1.5 rounded bg-white shadow-2xs border border-stone-200 text-stone-900 font-medium flex items-center gap-2">
                <span class="w-1.5 h-1.5 rounded-full bg-pink"></span>
                <span class="truncate">2. Architecture Deep Dive</span>
              </div>
              <div class="px-2.5 py-1.5 rounded text-stone-500 flex items-center gap-2">
                <span class="w-1.5 h-1.5 rounded-full bg-stone-300"></span>
                <span class="truncate">3. Speed & Benchmarks</span>
              </div>
            </div>
          </div>

          <!-- Middle Column: Editor Area -->
          <div class="col-span-12 md:col-span-6 p-6 font-sans relative">
            <div class="flex items-center justify-between border-b border-stone-100 pb-3 mb-4">
              <div class="flex items-center gap-2 text-stone-400 text-xs">
                <span>Markdown</span>
                <span>/</span>
                <span class="text-stone-700 font-medium">campaign-post-02.md</span>
              </div>
              <div class="flex items-center -space-x-1.5">
                <span class="w-6 h-6 rounded-full bg-pink text-white flex items-center justify-center text-[10px] font-bold border-2 border-white ring-1 ring-stone-200" title="David">D</span>
                <span class="w-6 h-6 rounded-full bg-emerald-600 text-white flex items-center justify-center text-[10px] font-bold border-2 border-white ring-1 ring-stone-200" title="Sarah">S</span>
              </div>
            </div>

            <!-- Content preview -->
            <div class="space-y-3 font-sans">
              <h3 class="text-xl font-bold font-serif text-stone-900 tracking-tight">
                Architecture Deep Dive: Multi-Platform Publishing
              </h3>

              <p class="text-xs text-stone-600 leading-relaxed">
                When content creators organize multi-day launches, cross-posting manually across platforms creates friction, fragmented discussion, and broken canonical links.
              </p>

              <div class="p-3 rounded-lg bg-stone-50 border border-stone-200/80 font-mono text-[11px] text-stone-800 leading-normal">
                <span class="text-stone-400">## Target Matrix</span><br />
                - Hashnode: `publishAsDraft: false`<br />
                - Dev.to: `canonical_url: https://bebopcms.com/...`<br />
                - Bluesky: `thread: true, split_at: "\n\n"`
              </div>

              <!-- Live multiplayer cursor mockup -->
              <div class="relative pt-1">
                <p class="text-xs text-stone-700 leading-relaxed">
                  With Bebop, the unified editor synchronizes Markdown while preserving individual metadata...
                </p>
                <!-- David cursor -->
                <div class="inline-flex items-center gap-1 bg-pink text-white text-[10px] font-medium px-1.5 py-0.5 rounded shadow-xs ml-1">
                  <span class="w-1 h-3 border-r-2 border-white animate-pulse"></span>
                  David typing
                </div>
              </div>
            </div>
          </div>

          <!-- Right Column: Broadcast & Cross-Posting Targets -->
          <div class="col-span-12 md:col-span-3 bg-stone-50/40 p-4 font-sans select-none border-t md:border-t-0 border-stone-100">
            <div class="text-[11px] font-semibold text-stone-500 uppercase tracking-wider mb-3">
              Distribution
            </div>

            <div class="space-y-2.5">
              <!-- Target 1: Hashnode -->
              <div class="p-2.5 rounded-lg bg-white border border-stone-200 shadow-2xs">
                <div class="flex items-center justify-between mb-1">
                  <span class="font-medium text-stone-800 flex items-center gap-1.5">
                    <span class="w-2 h-2 rounded-full bg-blue-500"></span> Hashnode
                  </span>
                  <span class="text-[10px] text-emerald-600 font-medium">Ready</span>
                </div>
                <div class="text-[10px] text-stone-500 truncate">blog.acme.dev/deep-dive</div>
              </div>

              <!-- Target 2: Dev.to -->
              <div class="p-2.5 rounded-lg bg-white border border-stone-200 shadow-2xs">
                <div class="flex items-center justify-between mb-1">
                  <span class="font-medium text-stone-800 flex items-center gap-1.5">
                    <span class="w-2 h-2 rounded-full bg-stone-900"></span> Dev.to
                  </span>
                  <span class="text-[10px] text-emerald-600 font-medium">Synced</span>
                </div>
                <div class="text-[10px] text-stone-500">Canonical link verified</div>
              </div>

              <!-- Target 3: Bluesky -->
              <div class="p-2.5 rounded-lg bg-white border border-stone-200 shadow-2xs">
                <div class="flex items-center justify-between mb-1">
                  <span class="font-medium text-stone-800 flex items-center gap-1.5">
                    <span class="w-2 h-2 rounded-full bg-sky-500"></span> Bluesky
                  </span>
                  <span class="text-[10px] text-amber-600 font-medium">Scheduled</span>
                </div>
                <div class="text-[10px] text-stone-500">Thread: Today 10:00 AM</div>
              </div>

              <!-- Target 4: Mastodon -->
              <div class="p-2.5 rounded-lg bg-white border border-stone-200 shadow-2xs">
                <div class="flex items-center justify-between mb-1">
                  <span class="font-medium text-stone-800 flex items-center gap-1.5">
                    <span class="w-2 h-2 rounded-full bg-purple-500"></span> Mastodon
                  </span>
                  <span class="text-[10px] text-stone-400">Draft</span>
                </div>
                <div class="text-[10px] text-stone-500">CW tags assigned</div>
              </div>
            </div>

            <div class="mt-5 pt-3 border-t border-stone-200">
              <div class="w-full py-2 px-3 rounded-md bg-stone-900 text-white font-medium text-center text-xs shadow-xs">
                Publish Campaign (3)
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
