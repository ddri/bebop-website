---
import { Mail, User, MessageSquare } from '@lucide/astro';
---

<section id="waitlist" class="w-full py-24 bg-stone-50/70 border-t border-stone-200/80 relative overflow-hidden">
  <!-- Subtle ambient glow -->
  <div class="absolute bottom-0 left-1/2 -translate-x-1/2 w-[600px] h-[300px] bg-pink/10 blur-[100px] pointer-events-none -z-10 rounded-full"></div>

  <div class="max-w-xl mx-auto px-6">
    <div class="bg-white rounded-3xl border border-stone-200 p-8 sm:p-10 shadow-sm relative">
      <div class="text-center mb-8">
        <div class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-pink/10 text-pink text-xs font-semibold uppercase tracking-wider mb-3">
          Early Access
        </div>
        <h2 class="text-3xl font-bold text-stone-900 mb-2.5">
          Request your invite.
        </h2>
        <p class="text-stone-600 text-sm leading-relaxed">
          We are onboarding creators and teams in weekly cohorts. Tell us a bit about your content workflow to reserve a spot.
        </p>
      </div>

      <form id="waitlist-form" class="space-y-4 font-sans">
        <!-- Honeypot field — hidden from real users, filled by bots -->
        <div class="absolute opacity-0 top-0 left-0 h-0 w-0 -z-10 overflow-hidden" aria-hidden="true">
          <label for="waitlist-website">Website</label>
          <input type="text" id="waitlist-website" name="website" tabindex="-1" autocomplete="off" />
        </div>

        <div>
          <label for="waitlist-name" class="block text-xs font-semibold text-stone-700 uppercase tracking-wider mb-1.5">
            Your Name
          </label>
          <div class="relative">
            <User class="absolute left-3.5 top-1/2 -translate-y-1/2 h-4 w-4 text-stone-400" />
            <input
              type="text"
              id="waitlist-name"
              name="name"
              required
              placeholder="Alex Chen"
              class="w-full pl-10 pr-4 py-2.5 bg-stone-50/50 border border-stone-200 rounded-xl text-stone-900 text-sm placeholder:text-stone-400 focus:outline-none focus:ring-2 focus:ring-pink/40 focus:border-pink transition-all"
            />
          </div>
        </div>

        <div>
          <label for="waitlist-email" class="block text-xs font-semibold text-stone-700 uppercase tracking-wider mb-1.5">
            Work or Personal Email
          </label>
          <div class="relative">
            <Mail class="absolute left-3.5 top-1/2 -translate-y-1/2 h-4 w-4 text-stone-400" />
            <input
              type="email"
              id="waitlist-email"
              name="email"
              required
              placeholder="alex@example.com"
              class="w-full pl-10 pr-4 py-2.5 bg-stone-50/50 border border-stone-200 rounded-xl text-stone-900 text-sm placeholder:text-stone-400 focus:outline-none focus:ring-2 focus:ring-pink/40 focus:border-pink transition-all"
            />
          </div>
        </div>

        <div>
          <label for="waitlist-reason" class="block text-xs font-semibold text-stone-700 uppercase tracking-wider mb-1.5">
            What are you planning to publish? <span class="text-stone-400 font-normal lowercase">(optional)</span>
          </label>
          <div class="relative">
            <MessageSquare class="absolute left-3.5 top-3.5 h-4 w-4 text-stone-400" />
            <textarea
              id="waitlist-reason"
              name="reason"
              rows="3"
              placeholder="e.g. Engineering blog, newsletter cross-posts, dev marketing..."
              class="w-full pl-10 pr-4 py-2.5 bg-stone-50/50 border border-stone-200 rounded-xl text-stone-900 text-sm placeholder:text-stone-400 focus:outline-none focus:ring-2 focus:ring-pink/40 focus:border-pink transition-all resize-none"
            ></textarea>
          </div>
        </div>

        <button
          type="submit"
          id="waitlist-submit"
          class="w-full inline-flex items-center justify-center rounded-xl text-sm font-semibold h-11 px-6 bg-stone-900 text-stone-50 hover:bg-stone-800 transition-all shadow-xs cursor-pointer"
        >
          Join the Early Access List
        </button>

        <p class="text-[11px] text-center text-stone-400 pt-1">
          No spam. Your email will strictly be used for your invitation.
        </p>

        <p id="waitlist-error" class="text-red-600 text-xs text-center hidden"></p>
      </form>

      <div id="waitlist-success" class="hidden text-center py-10">
        <div class="w-12 h-12 rounded-full bg-emerald-100 text-emerald-600 flex items-center justify-center mx-auto mb-4 font-bold text-xl">
          ✓
        </div>
        <h3 class="text-xl font-bold text-stone-900 mb-2">You're on the list!</h3>
        <p class="text-stone-600 text-sm max-w-sm mx-auto leading-relaxed">
          We've received your request. We'll send your invite code directly to your inbox as spots open.
        </p>
      </div>
    </div>
  </div>
</section>

<script>
  const form = document.getElementById('waitlist-form') as HTMLFormElement;
  const submitBtn = document.getElementById('waitlist-submit') as HTMLButtonElement;
  const errorEl = document.getElementById('waitlist-error') as HTMLElement;
  const successEl = document.getElementById('waitlist-success') as HTMLElement;

  form.addEventListener('submit', async (e) => {
    e.preventDefault();
    errorEl.classList.add('hidden');
    submitBtn.disabled = true;
    submitBtn.textContent = 'Submitting...';

    const name = (document.getElementById('waitlist-name') as HTMLInputElement).value.trim();
    const email = (document.getElementById('waitlist-email') as HTMLInputElement).value.trim();
    const reason = (document.getElementById('waitlist-reason') as HTMLTextAreaElement).value.trim();
    const website = (document.getElementById('waitlist-website') as HTMLInputElement).value;

    // Honeypot: if the hidden field is filled, silently fake success
    if (website) {
      form.classList.add('hidden');
      successEl.classList.remove('hidden');
      return;
    }

    try {
      const res = await fetch('https://app.bebopcms.com/api/waitlist', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ name, email, ...(reason && { reason }) }),
      });

      if (res.ok || res.status === 201) {
        form.classList.add('hidden');
        successEl.classList.remove('hidden');
      } else {
        const data = await res.json().catch(() => null);
        errorEl.textContent = data?.message || 'Something went wrong. Please try again.';
        errorEl.classList.remove('hidden');
      }
    } catch {
      errorEl.textContent = 'Unable to connect. Please try again later.';
      errorEl.classList.remove('hidden');
    } finally {
      submitBtn.disabled = false;
      submitBtn.textContent = 'Join the Waitlist';
    }
  });
</script>
