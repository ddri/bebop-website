---
import { FileCode, Cpu, Database, Share2, ChevronDown, ArrowRight, ArrowDown, ShieldCheck, Terminal } from '@lucide/astro';

const architectureStages = [
  {
    step: "STAGE 01",
    title: "Git / Markdown Drafts",
    subtitle: "Source & Campaign Graph",
    icon: FileCode,
    accent: "text-stone-300",
    borderAccent: "border-stone-700/80",
    badgeBg: "bg-stone-900 text-stone-400 border-stone-800",
    specs: [
      "Standard .md / .mdx + YAML",
      "Multi-post release timeline",
      "Local or multiplayer editor"
    ]
  },
  {
    step: "STAGE 02",
    title: "Bebop AST Compiler & Canonical Engine",
    subtitle: "Transform & Verification",
    icon: Cpu,
    accent: "text-pink",
    borderAccent: "border-pink/40",
    badgeBg: "bg-pink/15 text-pink border-pink/30",
    specs: [
      "Remark / Rehype AST transforms",
      "Live canonical_url verifier",
      "Semantic social thread splitter"
    ]
  },
  {
    step: "STAGE 03",
    title: "Postgres + Redis BullMQ Worker",
    subtitle: "State & Resilient Queue",
    icon: Database,
    accent: "text-amber-400",
    borderAccent: "border-amber-500/30",
    badgeBg: "bg-amber-950/50 text-amber-400 border-amber-800/50",
    specs: [
      "PostgreSQL 15+ (Prisma ORM)",
      "BullMQ scheduled dispatch",
      "Auto-backoff & rate-limit guard"
    ]
  },
  {
    step: "STAGE 04",
    title: "Destination Adapters",
    subtitle: "Multi-Channel Syndicate",
    icon: Share2,
    accent: "text-emerald-400",
    borderAccent: "border-emerald-500/30",
    badgeBg: "bg-emerald-950/50 text-emerald-400 border-emerald-800/50",
    specs: [
      "Hashnode & Dev.to GraphQL/REST",
      "Beehiiv newsletter payloads",
      "AT Proto (Bluesky) & Mastodon"
    ]
  }
];

const faqs = [
  {
    category: "Positioning",
    question: "How does Bebop differ from Ghost, WordPress, or Buffer?",
    answer: "Ghost and WordPress are monolithic publishing destinations designed to host a single publication, while Buffer is built to schedule short social blurbs. Bebop is a multi-channel campaign orchestrator engineered specifically for technical content. It understands Markdown ASTs, fenced code blocks, semantic thread splitting, and cross-posting with canonical SEO URLs intact—Bridging your primary engineering blog, developer communities, newsletters, and federated social networks in a single release graph."
  },
  {
    category: "Integration",
    question: "Can I use Bebop alongside my existing Astro, Next.js, or Hugo blog?",
    answer: "Yes—that is one of the most common workflows. Your Git-backed static site (Astro, Next.js, Hugo, Eleventy, or Fumadocs) remains the primary canonical source of truth on your domain. Once your primary post is live, Bebop verifies the live canonical URL and automatically syndicates adapted payloads to Dev.to, Hashnode, Beehiiv, Bluesky, and Mastodon with `canonical_url` headers pre-populated so search engines credit your main domain."
  },
  {
    category: "Licensing",
    question: "What does the GNU AGPL-3.0 license mean for my team and content?",
    answer: "Your content, Markdown files, custom workflows, and campaign analytics belong 100% to you with zero restrictions. Using Bebop internally within your company or team—whether on a private VPS or Bebop Cloud—does not require you to open-source your blog, website, or proprietary adapters. The GNU AGPL-3.0 copyleft provisions only apply if you modify Bebop's core source code and offer that modified CMS to third parties as a hosted network service."
  },
  {
    category: "Self-Hosting",
    question: "What is required to self-host Bebop Community Edition?",
    answer: "Bebop Community Edition deploys via a single `docker compose up -d` stack containing the Node.js/Bun web and worker runtime, PostgreSQL 15+ for relational state, and Redis for the BullMQ scheduling and retry queue. The entire stack idles under 350MB of RAM and runs comfortably on any $5–$10/month VPS (Hetzner, DigitalOcean, Fly.io, Railway) or internal Kubernetes cluster."
  },
  {
    category: "Security",
    question: "How are platform API keys and OAuth tokens secured?",
    answer: "In Self-Hosted mode, third-party API keys and OAuth refresh tokens never leave your infrastructure; they are encrypted at rest in your PostgreSQL instance using AES-256-GCM derived from your local environment secret key. In Bebop Cloud, credentials are encrypted via an isolated KMS-backed secret vault with strict per-workspace key rotation and scoped least-privilege access during worker execution."
  },
  {
    category: "Extensibility",
    question: "Can I write custom destination adapters?",
    answer: "Yes. Every publishing target in Bebop implements a clean, modular TypeScript `DestinationAdapter` interface (`validateConfig`, `compilePayload`, `publish`, and `getStatus`). You can easily author custom adapters for internal Slack/Discord launch notifications, Discourse forums, custom webhook pipelines, or proprietary enterprise CMS endpoints."
  }
];
---

<section id="faq" class="w-full py-24 border-t border-stone-800/80 bg-[#0C0A09]">
  <div class="max-w-6xl mx-auto px-6">
    <!-- Section Heading -->
    <div class="max-w-3xl mb-14 text-left">
      <div class="inline-flex items-center gap-2 px-2.5 py-1 rounded bg-stone-900 border border-stone-800 text-stone-300 text-xs font-mono mb-4">
        <Terminal class="w-3.5 h-3.5 text-pink" />
        <span>Architecture & Technical FAQ</span>
      </div>
      <h2 class="text-3xl sm:text-4xl font-bold text-white mb-4 tracking-tight font-sans">
        Engineered for transparency. Built to inspect.
      </h2>
      <p class="text-stone-400 text-base sm:text-lg leading-relaxed font-sans">
        How Bebop compiles, queues, and dispatches your technical campaigns under the hood—and answers to common questions from engineering and DevRel teams.
      </p>
    </div>

    <!-- System Architecture Overview Schematic -->
    <div class="bg-[#141211] rounded-2xl border border-stone-800 p-6 sm:p-8 mb-16 shadow-xl">
      <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3 pb-6 mb-8 border-b border-stone-800/80 font-mono">
        <div class="flex items-center gap-2.5">
          <span class="w-2 h-2 rounded-full bg-pink"></span>
          <span class="text-xs font-semibold text-white uppercase tracking-wider">System Architecture Overview</span>
          <span class="text-[11px] text-stone-500 hidden sm:inline">// Deterministic Dispatch Pipeline</span>
        </div>
        <div class="flex items-center gap-2 text-[11px] text-stone-400">
          <span class="px-2 py-0.5 rounded bg-[#0D0B0A] border border-stone-800 text-emerald-400">Idempotent Workers</span>
          <span class="px-2 py-0.5 rounded bg-[#0D0B0A] border border-stone-800 text-stone-300">AST-Native</span>
        </div>
      </div>

      <!-- 4-Stage Pipeline Grid -->
      <div class="grid grid-cols-1 lg:grid-cols-4 gap-4 lg:gap-5 relative font-sans">
        {architectureStages.map((stage, index) => (
          <div class="relative flex flex-col">
            <div class={`flex-1 bg-[#0D0B0A] rounded-xl border ${stage.borderAccent} p-5 flex flex-col justify-between hover:border-stone-600 transition-colors`}>
              <div>
                <div class="flex items-center justify-between mb-4">
                  <span class={`font-mono text-[10px] font-semibold px-2 py-0.5 rounded border ${stage.badgeBg}`}>
                    {stage.step}
                  </span>
                  <div class={`w-8 h-8 rounded-lg bg-[#161413] border border-stone-800 flex items-center justify-center ${stage.accent}`}>
                    <stage.icon class="w-4 h-4" />
                  </div>
                </div>

                <h3 class="text-sm font-bold text-white mb-1 leading-snug">
                  {stage.title}
                </h3>
                <p class="text-[11px] font-mono text-stone-400 mb-4">
                  {stage.subtitle}
                </p>
              </div>

              <ul class="space-y-1.5 pt-3 border-t border-stone-800/70 font-mono text-[11px] text-stone-300">
                {stage.specs.map((spec) => (
                  <li class="flex items-center gap-1.5">
                    <span class="text-stone-500">&rsaquo;</span>
                    <span>{spec}</span>
                  </li>
                ))}
              </ul>
            </div>

            {index < architectureStages.length - 1 && (
              <>
                <!-- Desktop Connector Arrow -->
                <div class="hidden lg:flex items-center justify-center absolute -right-3.5 top-1/2 -translate-y-1/2 z-10 w-5 h-5 rounded-full bg-[#1C1A18] border border-stone-700 text-stone-400 shadow-sm">
                  <ArrowRight class="w-3 h-3" />
                </div>
                <!-- Mobile Connector Arrow -->
                <div class="flex lg:hidden items-center justify-center my-1.5 text-stone-500">
                  <ArrowDown class="w-4 h-4" />
                </div>
              </>
            )}
          </div>
        ))}
      </div>

      <!-- Schematic Footer Bar -->
      <div class="mt-6 pt-5 border-t border-stone-800/80 flex flex-wrap items-center justify-between gap-4 font-mono text-[11px] text-stone-400">
        <div class="flex flex-wrap items-center gap-x-6 gap-y-2">
          <span><strong class="text-stone-200">Targets:</strong> Hashnode &bull; Dev.to &bull; Beehiiv &bull; AT Proto &bull; Mastodon</span>
          <span><strong class="text-stone-200">Encryption:</strong> AES-256-GCM / Cloud KMS</span>
        </div>
        <div class="inline-flex items-center gap-1.5 text-stone-300">
          <ShieldCheck class="w-3.5 h-3.5 text-emerald-400" />
          <span>Zero outbound telemetry in Community Edition</span>
        </div>
      </div>
    </div>

    <!-- Interactive Technical FAQ Accordion -->
    <div class="max-w-4xl mx-auto">
      <div class="flex items-center justify-between mb-6">
        <h3 class="text-xl font-bold text-white font-sans">
          Frequently Asked Questions
        </h3>
        <span class="text-xs font-mono text-stone-400">
          6 technical specifications
        </span>
      </div>

      <div class="space-y-3 font-sans">
        {faqs.map((item, idx) => (
          <details
            class="group bg-[#141211] rounded-2xl border border-stone-800 open:border-stone-700 transition-colors overflow-hidden"
            open={idx === 0}
          >
            <summary class="flex items-center justify-between gap-4 px-6 py-5 cursor-pointer list-none select-none text-left hover:bg-[#181615]/60 transition-colors">
              <div class="flex flex-col sm:flex-row sm:items-center gap-2 sm:gap-3.5">
                <span class="w-fit font-mono text-[10px] font-semibold uppercase tracking-wider px-2 py-0.5 rounded bg-stone-900 border border-stone-800 text-stone-400 group-open:text-pink group-open:border-pink/40 group-open:bg-pink/10 transition-colors">
                  {item.category}
                </span>
                <span class="text-base font-semibold text-white group-hover:text-stone-100">
                  {item.question}
                </span>
              </div>
              <span class="w-7 h-7 rounded-lg bg-[#1C1A18] border border-stone-700/80 flex items-center justify-center text-stone-400 shrink-0 group-open:rotate-180 group-open:text-white group-open:border-stone-600 transition-transform duration-200">
                <ChevronDown class="w-4 h-4" />
              </span>
            </summary>
            <div class="px-6 pb-6 pt-2 text-sm text-stone-300 leading-relaxed border-t border-stone-800/60">
              <p>{item.answer}</p>
            </div>
          </details>
        ))}
      </div>
    </div>
  </div>
</section>

<style>
  /* Remove default marker on Safari / Chrome */
  details > summary::-webkit-details-marker {
    display: none;
  }
</style>
