---
---

<footer class="w-full py-16 bg-[#080706] text-stone-400 border-t border-stone-850">
  <div class="max-w-6xl mx-auto px-6 font-sans">
    <div class="grid grid-cols-1 md:grid-cols-12 gap-10 pb-12 border-b border-stone-850">
      <div class="md:col-span-5 space-y-4">
        <div class="flex items-center gap-2">
          <span class="w-7 h-7 rounded-md bg-pink flex items-center justify-center text-white text-xs font-bold shadow-2xs">
            <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
              <path d="M9 18V5l12-2v13"></path>
              <circle cx="6" cy="18" r="3"></circle>
              <circle cx="18" cy="16" r="3"></circle>
            </svg>
          </span>
          <span class="text-xl font-bold font-serif text-white tracking-tight">Bebop</span>
        </div>
        <p class="text-xs text-stone-400 leading-relaxed max-w-sm">
          A content marketing platform for creators and teams. Available as free self-hosted open source under GNU AGPLv3, or as fully managed Bebop Cloud.
        </p>
        <div class="inline-flex items-center gap-2 px-2.5 py-1 rounded-full bg-stone-900 border border-stone-800 text-[11px] text-stone-300">
          <span class="w-1.5 h-1.5 rounded-full bg-emerald-400 animate-pulse"></span>
          <span>Cloud Beta Active</span>
        </div>
      </div>

      <div class="md:col-span-2 md:col-start-7">
        <h4 class="text-xs font-semibold uppercase tracking-wider text-stone-200 mb-4">Platform</h4>
        <ul class="space-y-2.5 text-xs">
          <li><a href="#features" class="hover:text-white transition-colors">Features</a></li>
          <li><a href="#how-it-works" class="hover:text-white transition-colors">How It Works</a></li>
          <li><a href="#open-source" class="hover:text-white transition-colors">Self-Host vs Cloud</a></li>
          <li><a href="#waitlist" class="hover:text-white transition-colors">Bebop Cloud</a></li>
        </ul>
      </div>

      <div class="md:col-span-2">
        <h4 class="text-xs font-semibold uppercase tracking-wider text-stone-200 mb-4">Ecosystem</h4>
        <ul class="space-y-2.5 text-xs">
          <li>
            <a href="https://github.com/ddri/bebop" target="_blank" rel="noopener noreferrer" class="hover:text-white transition-colors flex items-center gap-1">
              <span>GitHub</span>
              <span class="text-[10px] text-stone-500">&nearr;</span>
            </a>
          </li>
          <li>
            <a href="https://github.com/ddri/bebop/releases" target="_blank" rel="noopener noreferrer" class="hover:text-white transition-colors flex items-center gap-1">
              <span>Releases</span>
              <span class="text-[10px] text-stone-500">&nearr;</span>
            </a>
          </li>
          <li>
            <a href="https://github.com/ddri/bebop/blob/main/LICENSE" target="_blank" rel="noopener noreferrer" class="hover:text-white transition-colors">
              AGPL-3.0 License
            </a>
          </li>
        </ul>
      </div>

      <div class="md:col-span-2">
        <h4 class="text-xs font-semibold uppercase tracking-wider text-stone-200 mb-4">Legal</h4>
        <ul class="space-y-2.5 text-xs">
          <li><a href="/privacy" class="hover:text-white transition-colors">Privacy Policy</a></li>
          <li><a href="/terms" class="hover:text-white transition-colors">Terms of Service</a></li>
          <li><a href="mailto:hello@bebopcms.com" class="hover:text-white transition-colors">Contact</a></li>
        </ul>
      </div>
    </div>

    <div class="pt-8 flex flex-col sm:flex-row items-center justify-between gap-4 text-xs text-stone-500">
      <p>&copy; {new Date().getFullYear()} Bebop. Free open source under GNU AGPLv3 · Self-host or choose Bebop Cloud.</p>
      <p class="text-[11px]">Crafted for writers, developers, and content teams.</p>
    </div>
  </div>
</footer>
