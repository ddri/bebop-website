---
import { FolderKanban, Share2, Users, Clock, CircleCheck } from '@lucide/astro';
---

<section id="features" class="w-full py-24 border-t border-stone-200/80 bg-stone-50/50">
  <div class="max-w-6xl mx-auto px-6">
    <div class="text-center max-w-2xl mx-auto mb-16">
      <div class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-stone-200/60 text-stone-700 text-xs font-semibold uppercase tracking-wider mb-4">
        Platform Capabilities
      </div>
      <h2 class="text-3xl sm:text-4xl font-bold text-stone-900 mb-4">
        Everything you need to orchestrate campaigns.
      </h2>
      <p class="text-stone-600 text-base sm:text-lg leading-relaxed">
        Stop juggling four tabs, broken canonical tags, and messy copy-pasting. Bebop treats publishing as a coordinated team workflow.
      </p>
    </div>

    <!-- Bento Grid -->
    <div class="grid grid-cols-1 md:grid-cols-12 gap-6">
      <!-- Bento 1: Campaign-First (7 cols) -->
      <div class="md:col-span-7 bg-white rounded-2xl border border-stone-200 p-8 shadow-xs flex flex-col justify-between overflow-hidden relative group">
        <div class="mb-6">
          <div class="w-10 h-10 rounded-xl bg-pink/10 text-pink flex items-center justify-center mb-5">
            <FolderKanban class="w-5 h-5" />
          </div>
          <h3 class="text-xl font-bold text-stone-900 mb-2">Campaign-First Architecture</h3>
          <p class="text-sm text-stone-600 leading-relaxed max-w-md">
            Organize articles, release notes, and social threads around unified launch goals. Coordinate publishing as one sequence rather than scattered standalone posts.
          </p>
        </div>

        <!-- Micro UI Widget: Mini Campaign Sequence -->
        <div class="bg-stone-50 rounded-xl border border-stone-200/70 p-4 space-y-2.5 font-sans">
          <div class="flex items-center justify-between text-xs text-stone-500 pb-2 border-b border-stone-200/60 font-medium">
            <span>Campaign: Q3 Launch Week</span>
            <span class="text-emerald-600 font-semibold">2 of 3 Ready</span>
          </div>

          <div class="flex items-center justify-between p-2.5 bg-white rounded-lg border border-stone-200 text-xs">
            <div class="flex items-center gap-2">
              <CircleCheck class="w-4 h-4 text-emerald-500" />
              <span class="font-medium text-stone-800">Part 1: The Vision & Architecture</span>
            </div>
            <span class="text-[11px] px-2 py-0.5 rounded bg-stone-100 text-stone-600 font-medium">Published</span>
          </div>

          <div class="flex items-center justify-between p-2.5 bg-white rounded-lg border border-pink/40 text-xs shadow-2xs">
            <div class="flex items-center gap-2">
              <span class="w-2 h-2 rounded-full bg-pink animate-pulse"></span>
              <span class="font-medium text-stone-900">Part 2: Technical Deep Dive</span>
            </div>
            <span class="text-[11px] px-2 py-0.5 rounded bg-pink/10 text-pink font-semibold">In Review</span>
          </div>
        </div>
      </div>

      <!-- Bento 2: Publish Everywhere (5 cols) -->
      <div class="md:col-span-5 bg-white rounded-2xl border border-stone-200 p-8 shadow-xs flex flex-col justify-between">
        <div class="mb-6">
          <div class="w-10 h-10 rounded-xl bg-blue-50 text-blue-600 flex items-center justify-center mb-5">
            <Share2 class="w-5 h-5" />
          </div>
          <h3 class="text-xl font-bold text-stone-900 mb-2">Publish Everywhere</h3>
          <p class="text-sm text-stone-600 leading-relaxed">
            Write once in Markdown. Automatic frontmatter translation and canonical URL preservation across developer & federated channels.
          </p>
        </div>

        <!-- Platform Pills Grid -->
        <div class="grid grid-cols-2 gap-2 text-xs font-medium text-stone-700">
          <div class="flex items-center gap-2 p-2.5 rounded-lg bg-stone-50 border border-stone-200">
            <span class="w-2 h-2 rounded-full bg-blue-500"></span>
            <span>Hashnode</span>
          </div>
          <div class="flex items-center gap-2 p-2.5 rounded-lg bg-stone-50 border border-stone-200">
            <span class="w-2 h-2 rounded-full bg-stone-900"></span>
            <span>Dev.to</span>
          </div>
          <div class="flex items-center gap-2 p-2.5 rounded-lg bg-stone-50 border border-stone-200">
            <span class="w-2 h-2 rounded-full bg-sky-500"></span>
            <span>Bluesky</span>
          </div>
          <div class="flex items-center gap-2 p-2.5 rounded-lg bg-stone-50 border border-stone-200">
            <span class="w-2 h-2 rounded-full bg-purple-500"></span>
            <span>Mastodon</span>
          </div>
        </div>
      </div>

      <!-- Bento 3: Real-Time Multiplayer (5 cols) -->
      <div class="md:col-span-5 bg-white rounded-2xl border border-stone-200 p-8 shadow-xs flex flex-col justify-between">
        <div class="mb-6">
          <div class="w-10 h-10 rounded-xl bg-emerald-50 text-emerald-600 flex items-center justify-center mb-5">
            <Users class="w-5 h-5" />
          </div>
          <h3 class="text-xl font-bold text-stone-900 mb-2">Real-Time Multiplayer</h3>
          <p class="text-sm text-stone-600 leading-relaxed">
            Co-write campaigns with presence, live typing cursors, and inline suggestions. No merge conflicts, no overwritten drafts.
          </p>
        </div>

        <!-- Collaborators Stack Widget -->
        <div class="p-3.5 bg-stone-50 rounded-xl border border-stone-200/80 flex items-center justify-between">
          <div class="flex items-center -space-x-2">
            <span class="w-8 h-8 rounded-full bg-pink text-white flex items-center justify-center text-xs font-bold border-2 border-white shadow-2xs">DR</span>
            <span class="w-8 h-8 rounded-full bg-emerald-600 text-white flex items-center justify-center text-xs font-bold border-2 border-white shadow-2xs">SC</span>
            <span class="w-8 h-8 rounded-full bg-amber-500 text-white flex items-center justify-center text-xs font-bold border-2 border-white shadow-2xs">LM</span>
          </div>
          <span class="text-xs font-medium text-stone-600 flex items-center gap-1.5">
            <span class="w-2 h-2 rounded-full bg-emerald-500"></span>
            3 collaborators editing
          </span>
        </div>
      </div>

      <!-- Bento 4: Smart Scheduling (7 cols) -->
      <div class="md:col-span-7 bg-white rounded-2xl border border-stone-200 p-8 shadow-xs flex flex-col justify-between">
        <div class="mb-6">
          <div class="w-10 h-10 rounded-xl bg-purple-50 text-purple-600 flex items-center justify-center mb-5">
            <Clock class="w-5 h-5" />
          </div>
          <h3 class="text-xl font-bold text-stone-900 mb-2">Intelligent Schedule & Delivery</h3>
          <p class="text-sm text-stone-600 leading-relaxed max-w-md">
            Queue posts across staggered release windows. Automated exponential backoff handles platform rate-limits so your posts never get dropped.
          </p>
        </div>

        <!-- Queue Status Matrix -->
        <div class="bg-stone-50 rounded-xl border border-stone-200/70 p-4 font-sans text-xs">
          <div class="flex items-center justify-between text-stone-500 font-medium mb-2.5">
            <span>Scheduled Release Window</span>
            <span class="text-stone-700">Tuesday · 09:00 UTC</span>
          </div>
          <div class="w-full bg-stone-200 rounded-full h-2 overflow-hidden flex">
            <div class="bg-emerald-500 h-2 w-2/3"></div>
            <div class="bg-amber-400 h-2 w-1/6"></div>
            <div class="bg-stone-300 h-2 w-1/6"></div>
          </div>
          <div class="flex items-center justify-between text-[11px] text-stone-500 mt-2 font-mono">
            <span>2 Dispatched</span>
            <span>1 Queued</span>
            <span>0 Failed</span>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
