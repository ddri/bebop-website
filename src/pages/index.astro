---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import Features from '../components/Features.astro';
import HowItWorks from '../components/HowItWorks.astro';
import Editions from '../components/Editions.astro';
import Waitlist from '../components/Waitlist.astro';
import Footer from '../components/Footer.astro';
---

<Layout title="Bebop - The Campaign CMS for Technical Content Teams">
  <main class="flex min-h-screen flex-col items-center justify-between">
    <Header />
    <Hero />
    <Features />
    <HowItWorks />
    <Editions />
    <Waitlist />
    <Footer />
  </main>
</Layout>
